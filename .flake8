[flake8]
max-line-length = 88
exclude = build,dist,.venv
ignore = R201,W503
per-file-ignores =
    tests/*: D100,D101,D102,D103,D104,D105,D106,D107,ANN001,ANN201,ANN202,ANN204,ANN205,ANN206,ANN401,F811,F401
    src/*/tests/*: D100,D101,D102,D103,D104,D105,D106,D107,ANN001,ANN201,ANN202,ANN204,ANN205,ANN206,ANN401,F811,F401
